APP_NAME=online_judge
NODE_ENV=development
BASE_URL=http://localhost:5000

BACKEND_PORT=5000
FRONTEND_PORT=5173

MONGODB_URI=mongodb://localhost:27017/online_judge

JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_LIMIT_DAYS=7
ACCESS_TOKEN_LIMIT_HOURS=12

# Pluggable File Storage Configuration
STORAGE_PROVIDER=minio # Options: minio, gcs, s3

# MinIO Config
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=submissions
MINIO_USE_SSL=false

# Google Cloud Storage config
GCS_BUCKET=your-gcs-bucket
GCS_PROJECT_ID=your-gcp-project-id
GCS_KEY_FILE=./gcp-storage-key.json

# AWS S3 config
S3_BUCKET=your-s3-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Frontend production environment URLs
VITE_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api
# FRONTEND_URL=https://your-frontend-domain.com
